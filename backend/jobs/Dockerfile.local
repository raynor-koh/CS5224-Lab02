FROM python:3.11-slim-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-17-jre-headless \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY backend/jobs/requirements-aws.txt /app/requirements-aws.txt
RUN pip install --no-cache-dir pyspark==3.5.7 -r /app/requirements-aws.txt
COPY backend/jobs/process.py /app/process.py

ENTRYPOINT ["spark-submit", "--master", "local[*]", "/app/process.py"]
CMD ["file:///workspace/data/twitter_combined.txt", "userStats"]
