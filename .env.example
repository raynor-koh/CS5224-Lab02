# The API uses Application Default Credentials. Locally, run
# `gcloud auth application-default login`; Cloud Run uses its service account.
PORT=8080
FRONTEND_ORIGIN=http://localhost:3000

GCP_PROJECT_ID=
GCP_REGION=asia-southeast1
FIRESTORE_COLLECTION=userStats
GCP_DATAPROC_STAGING_BUCKET=gs://YOUR_BUCKET
PROCESSING_ENTRY_POINT=gs://YOUR_BUCKET/jobs/process.py
PROCESSING_INPUT_URI=gs://YOUR_BUCKET/data/twitter_combined.txt
PROCESSING_PY_FILES=gs://YOUR_BUCKET/dependencies/google-cloud-firestore.zip

# Used only by the administrative POST/GET /api/jobs routes. Keep it private.
PROCESSING_API_TOKEN=
