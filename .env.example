# The API uses the AWS default credential chain. A deployed backend should use
# an IAM role; never put long-lived access keys in this file.
PORT=8080
FRONTEND_ORIGIN=http://localhost:3000

AWS_REGION=ap-southeast-1
DYNAMODB_TABLE=userStats
# Only for local Floci use; remove it when pointing at real AWS.
# AWS_ENDPOINT_URL=http://localhost:4566
EMR_SERVERLESS_APPLICATION_ID=
EMR_SERVERLESS_EXECUTION_ROLE_ARN=
PROCESSING_ENTRY_POINT=s3://YOUR_BUCKET/jobs/process.py
PROCESSING_INPUT_URI=s3://YOUR_BUCKET/data/twitter_combined.txt
PROCESSING_LOG_URI=s3://YOUR_BUCKET/logs/
PROCESSING_PY_FILES=s3://YOUR_BUCKET/dependencies/boto3.zip
# Keep the executor bound small for this coursework run. EMR Serverless uses
# dynamic allocation; this limits it to two executors.
PROCESSING_SPARK_SUBMIT_PARAMETERS=--conf spark.executor.cores=1 --conf spark.executor.memory=4g --conf spark.driver.cores=1 --conf spark.driver.memory=4g --conf spark.dynamicAllocation.maxExecutors=2

# Used only by the administrative POST/GET /api/jobs routes. Keep it private.
PROCESSING_API_TOKEN=
